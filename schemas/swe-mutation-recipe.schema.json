{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haolpku/SWEFoundry/schemas/swe-mutation-recipe.schema.json",
  "title": "SWEFoundry SWE Mutation Recipe v1",
  "type": "object",
  "required": ["task_id", "repo_url", "base_commit", "instruction", "test_command", "fail_to_pass", "mutation"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "repo_url": {"type": "string", "pattern": "^https://github.com/"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,40}$"},
    "instruction": {"type": "string", "minLength": 1},
    "image_name": {"type": "string"},
    "repo_path": {"type": "string", "pattern": "^/"},
    "test_command": {"type": "string", "pattern": "(^| )\\{test\\}( |$)"},
    "fail_to_pass": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "pass_to_pass": {"type": "array", "items": {"type": "string"}},
    "mutation": {
      "type": "object",
      "required": ["name", "path", "find", "replace"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "find": {"type": "string", "minLength": 1},
        "replace": {"type": "string"}
      },
      "additionalProperties": false
    },
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
